# ============================================================
# S POS — production environment (website / SaaS deployment)
# Copy to `.env` next to docker-compose.prod.yml and fill in.
# Developed by Sridhar Mahalingam.
# ============================================================

# --- Core ---
DEBUG=False
# Generate a strong key: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
ALLOWED_HOSTS=pos.example.com,www.pos.example.com
CSRF_TRUSTED_ORIGINS=https://pos.example.com
CORS_ALLOWED_ORIGINS=https://pos.example.com

# --- Database (PostgreSQL) ---
POSTGRES_DB=spos
POSTGRES_USER=spos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Cache / broker (Redis) ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Email (transactional receipts) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=S POS <noreply@pos.example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=True

# --- Payments (pluggable: any provider worldwide) ---
# Options: manual | stripe | razorpay | paytabs | paypal | adyen | square |
#          flutterwave | paystack | mpesa | mercadopago | telr
PAYMENT_PROVIDER=manual
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_MERCHANT_ID=
# HMAC shared secret used to verify the provider's webhook callbacks
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# --- Error monitoring (optional) ---
SENTRY_DSN=
SENTRY_ENV=production
SENTRY_TRACES=0.1

LOG_LEVEL=INFO
